# Copie para .env e ajuste. O .env NÃO é versionado.

# Chave secreta do Django. Gere uma nova:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-esta-chave

# True apenas em desenvolvimento.
DEBUG=True

# Hosts liberados (separados por vírgula). Em produção, use o host EXATO — nunca
# um curinga como ".onrender.com". No Render, deixe em branco: o host real entra
# sozinho via RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados. Vazio = SQLite local (dev).
# Produção (exemplo): postgres://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=
# Tempo (s) que cada conexão PostgreSQL é reaproveitada. Padrão: 600.
# DB_CONN_MAX_AGE=600

# Número da Yslane no WhatsApp, em E.164 (ex.: +5583988887777) — usado pelo
# lembrete diário (manage.py enviar_lembrete_diario). O envio sai pela Evolution
# quando WHATSAPP_PROVIDER=evolution — ver apps/pagamentos/lembrete.py.
YSLANE_WHATSAPP_NUMERO=

# Fase 6 - WhatsApp via Evolution API (substitui a Cloud API da Meta). Mantenha
# "log" enquanto não houver instância da Evolution; "evolution" envia de verdade.
WHATSAPP_PROVIDER=log
WHATSAPP_PIX_CHAVE=
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Token compartilhado que autentica o webhook de status da Evolution.
EVOLUTION_WEBHOOK_TOKEN=

# Fase 7 - Cobrança Pix via Cora. Use primeiro as URLs e credenciais de Stage.
CORA_PROVIDER=log
CORA_CLIENT_ID=
CORA_CERT_PATH=
CORA_KEY_PATH=
CORA_TOKEN_URL=https://matls-clients.api.stage.cora.com.br/token
CORA_API_BASE_URL=https://matls-clients.api.stage.cora.com.br
# Token do webhook da Cora — cadastre a URL como .../webhooks/cora/?token=ESSE_VALOR
CORA_WEBHOOK_TOKEN=

# Somente produção (DEBUG=False):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=86400          # padrão 1 dia. Domínio próprio estável: 31536000
# SECURE_HSTS_PRELOAD=False          # só em domínio próprio — preload é irreversível
# CSRF_TRUSTED_ORIGINS=https://seu-dominio.com
# No Render, RENDER_EXTERNAL_HOSTNAME já entra sozinho em ALLOWED_HOSTS e
# CSRF_TRUSTED_ORIGINS — só preencha os de cima se usar domínio próprio.

# Tempo de sessão em segundos (padrão 43200 = 12 h).
# SESSION_COOKIE_AGE=43200

# Login: trava após N falhas (padrão 8) por COOLOFF horas (padrão 1).
# Destravar na mão: python manage.py axes_reset_username <nome>
# AXES_FAILURE_LIMIT=8
# AXES_COOLOFF_HOURS=1

# Nível de log (padrão: INFO nos dois). Suba para WARNING se o log ficar ruidoso.
# LOG_LEVEL_PAGAMENTOS=INFO
# LOG_LEVEL_DJANGO=INFO
