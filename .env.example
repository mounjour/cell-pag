# Copie para .env e ajuste. O .env NÃO é versionado.

# Chave secreta do Django. Gere uma nova:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-esta-chave

# True apenas em desenvolvimento.
DEBUG=True

# Hosts liberados (separados por vírgula). Em produção, use o domínio real.
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados. Vazio = SQLite local (dev).
# Produção (exemplo): postgres://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=

# Número da Yslane no WhatsApp, em E.164 (ex.: +5583988887777) — usado pelo
# lembrete diário (manage.py enviar_lembrete_diario). O envio de verdade
# ainda é um stub (só loga) até existir conta WhatsApp Business — ver
# apps/pagamentos/lembrete.py.
YSLANE_WHATSAPP_NUMERO=

# Fase 6 - WhatsApp oficial. Mantenha "log" enquanto não houver conta/credenciais.
WHATSAPP_PROVIDER=log
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PIX_CHAVE=
WHATSAPP_TEMPLATE_VENCIMENTO=cobranca_vencimento
WHATSAPP_TEMPLATE_ATRASO=cobranca_atraso
WHATSAPP_TEMPLATE_BLOQUEIO=cobranca_bloqueio

# Fase 7 - Pix dinâmico Cora. Use primeiro as URLs e credenciais de Stage.
CORA_PROVIDER=log
CORA_CLIENT_ID=
CORA_CERT_PATH=
CORA_KEY_PATH=
CORA_TOKEN_URL=https://matls-clients.api.stage.cora.com.br/token
CORA_API_BASE_URL=https://matls-clients.api.stage.cora.com.br

# Somente produção (DEBUG=False):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# CSRF_TRUSTED_ORIGINS=https://seu-dominio.com
